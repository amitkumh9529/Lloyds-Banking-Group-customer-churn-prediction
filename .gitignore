# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/
*.egg-info/
dist/
build/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Data ──────────────────────────────────────────────────────────────────────
# Raw data is never committed — share via DVC, S3, or secure transfer
data/raw/
data/processed/

# ── Model artefacts ───────────────────────────────────────────────────────────
# Large binary files — track with Git LFS or DVC if needed
models/*.pkl
models/*.joblib
models/*.h5
models/*.onnx
# Keep generated plots
!models/*.png

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── FastAPI / Uvicorn ─────────────────────────────────────────────────────────
*.pid

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.zip